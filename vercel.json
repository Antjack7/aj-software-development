{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/textproof",
      "destination": "https://textproof.net",
      "permanent": true
    },
    {
      "source": "/textproof/",
      "destination": "https://textproof.net/",
      "permanent": true
    },
    {
      "source": "/textproof/:path*",
      "destination": "https://textproof.net/:path*",
      "permanent": true
    }
  ]
}
