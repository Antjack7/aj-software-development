<aside class="signup-box">
  <h2>Get new guides by email</h2>
  <p>Practical guides on keeping, exporting and printing your messages. A few emails a year.</p>
  <form class="signup" novalidate>
      <label class="sr" for="su-email">Email address</label>
      <input id="su-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
      <input name="website" type="text" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true">
      <button type="submit">Sign up</button>
      <p class="signup-msg" role="status" aria-live="polite"></p>
    </form>
    <p class="signup-note">New guides and app updates, a few times a year. Unsubscribe any time. See our <a href="../privacy.html">privacy policy</a>.</p>
</aside>
<footer><div class="foot-in">
  <div>© 2026 AJ Software Development</div>
  <ul class="foot-links">
    <li><a href="/">TextProof</a></li>
    <li><a href="../privacy.html">Privacy</a></li>
    <li><a href="../support.html">Support</a></li>
  </ul>
</div></footer>
<script>
document.querySelectorAll('form.signup').forEach(function (f) {
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var msg = f.querySelector('.signup-msg'), btn = f.querySelector('button');
    var data = { email: f.email.value, website: f.website.value };
    btn.disabled = true; msg.textContent = 'Signing you up\u2026';
    fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (x.ok) { f.reset(); msg.textContent = 'Thanks, you\u2019re signed up.'; }
        else { msg.textContent = (x.j && x.j.error) || 'Something went wrong. Please try again.'; }
      })
      .catch(function () { msg.textContent = 'Something went wrong. Please try again.'; })
      .then(function () { btn.disabled = false; });
  });
});
</script>
</body>
</html>
